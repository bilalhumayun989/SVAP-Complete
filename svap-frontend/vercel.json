{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://best-builders-admin-panel.vercel.app/admin/api/:path*"
    },
    {
      "source": "/admin/_next/:path*",
      "destination": "https://best-builders-admin-panel.vercel.app/admin/_next/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://best-builders-admin-panel.vercel.app/admin/_next/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://best-builders-admin-panel.vercel.app/admin/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://best-builders-admin-panel.vercel.app/admin"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}